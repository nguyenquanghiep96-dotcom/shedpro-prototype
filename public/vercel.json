{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/v1/product/premium-shed/index.html"
    },
    {
      "source": "/v1/product/premium-shed",
      "destination": "/v1/product/premium-shed/index.html"
    },
    {
      "source": "/v1/product/premium-shed/",
      "destination": "/v1/product/premium-shed/index.html"
    },
    {
      "source": "/v1/garden-shed",
      "destination": "/v1/product/premium-shed/index.html"
    },
    {
      "source": "/v1/garden-shed/",
      "destination": "/v1/product/premium-shed/index.html"
    }
  ]
}
