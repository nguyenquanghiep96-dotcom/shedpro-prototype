{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "/public/index.html",
      "statusCode": 302
    },
    {
      "source": "/v1/shedpro-design/product/garden-shed/index.html",
      "destination": "/v1/product/premium-shed/",
      "statusCode": 301
    },
    {
      "source": "/v1/shedpro-design/product/garden-shed/",
      "destination": "/v1/product/premium-shed/",
      "statusCode": 301
    },
    {
      "source": "/v1/garden-shed",
      "destination": "/v1/product/premium-shed/",
      "statusCode": 301
    },
    {
      "source": "/v1/product/garden-shed",
      "destination": "/v1/product/premium-shed/",
      "statusCode": 301
    },
    {
      "source": "/v1/product/garden-shed/",
      "destination": "/v1/product/premium-shed/",
      "statusCode": 301
    }
  ],
  "rewrites": [
    {
      "source": "/configurator-cdn.shedpro.co/:path*",
      "destination": "/v1/configurator-cdn.shedpro.co/:path*"
    },
    {
      "source": "/dxm5q5264srx2.cloudfront.net/:path*",
      "destination": "/v1/dxm5q5264srx2.cloudfront.net/:path*"
    },
    {
      "source": "/www.google.com/:path*",
      "destination": "/v1/www.google.com/:path*"
    },
    {
      "source": "/js.stripe.com/:path*",
      "destination": "/v1/js.stripe.com/:path*"
    },
    {
      "source": "/v1/product/premium-shed",
      "destination": "/v1/shedpro-design/product/garden-shed/index.html"
    },
    {
      "source": "/v1/product/premium-shed/",
      "destination": "/v1/shedpro-design/product/garden-shed/index.html"
    },
    {
      "source": "/v2/product/premium-shed",
      "destination": "/v2/product/premium-shed/index.html"
    },
    {
      "source": "/v2/product/premium-shed/",
      "destination": "/v2/product/premium-shed/index.html"
    }
  ]
}
